{
  "name": "The Rumi - Self check-in",
  "short_name": "Rumi Check-in",
  "description": "Self check-in tablet for The Rumi Hotel & Residences, Dushanbe.",
  "id": "/tablet",
  "start_url": "/tablet",
  "scope": "/",
  "display": "fullscreen",
  "display_override": ["fullscreen", "standalone"],
  "orientation": "landscape",
  "background_color": "#F6F2E7",
  "theme_color": "#0E3B2E",
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Front desk", "url": "/staff", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
