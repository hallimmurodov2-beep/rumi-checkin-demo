<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- System bars are hidden in code (immersive); the window draws edge to edge. -->
    <style name="Kiosk" parent="@android:style/Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:windowBackground">@color/forest</item>
        <item name="android:statusBarColor">@color/forest</item>
        <item name="android:navigationBarColor">@color/forest</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:windowDisablePreview">false</item>
    </style>
</resources>
