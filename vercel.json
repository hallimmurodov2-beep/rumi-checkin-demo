{
  "rewrites": [{ "source": "/visitor-wifi", "destination": "/visitor-wifi.html" }, { "source": "/((?!assets/|gallery/|icons/|sw.js|manifest.webmanifest|visitor-wifi[.]html|emblem).*)", "destination": "/index.html" }],
  "headers": [
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
